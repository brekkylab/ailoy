{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core surface, the two window commands the custom title bar needs, and the confirm dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-confirm",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
