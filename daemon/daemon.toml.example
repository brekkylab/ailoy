# Copy this into the daemon's root directory as `daemon.toml`.
# Every field has a default, so an empty file (or no file) works too.
#
# Beside it goes `.env`, read into the daemon's own environment when it starts: the
# API key a model is reached with, and the variables `console.json` names its secrets
# by. A variable already in the environment wins.

# TCP address carrying `POST /events/{type}` alone. Administration and queries go
# over the socket instead, so this may face wherever event senders are.
#
# Whether it asks for a credential is not a setting here: put `AILOY_API_TOKEN` in the
# environment (`.env` beside this file will do) and a sender must bear it. Without the
# variable the address is open to whoever reaches it, which is why this is loopback.
listen = "127.0.0.1:7878"

# Socket file carrying every route, relative to this directory. Whoever may open it
# may administer the daemon.
socket = "daemon.sock"

# Events older than this are pruned. Default is 7 days.
# events_retention_secs = 604800

[console]
# `cortex-uvm-console` runs each command in a micro-VM, so it is what enforces the
# image, the network reach and the secrets `console.json` declares. Use it in
# development too: a workflow that only ever ran host-local has not been tried
# against the boundary it will meet.
#
# Absolute path: a relative one resolves against wherever `serve` was started, not
# against this file.
program = ["CHANGE-ME/cortex/target/debug/cortex-uvm-console"]

# `cortex-local-console` runs commands on this machine and enforces nothing the
# spec declares. Only for a machine that cannot virtualize.
# host = true

# Guest image of the shared console the trigger scripts run in. Needs python3.
# Pulled from a registry on first use and cached by digest.
image = "python:3.12-slim"

# Run status changes are POSTed here. Optional. Nothing authenticates the daemon to
# the receiver, so put whatever the receiver needs in the URL or terminate it behind
# something that does.
# [[hooks]]
# url = "https://example.com/ailoy"
# statuses = ["done", "failed"]      # empty means all
# triggers = []                      # empty means all
