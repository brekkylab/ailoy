---
// Starlight override: dark unless the reader picked light with the switch. Also restores a hidden
// sidebar before the page paints.
---

<script is:inline>
  (() => {
    let theme = 'dark';
    try {
      theme = localStorage.getItem('starlight-theme') === 'light' ? 'light' : 'dark';
      if (localStorage.getItem('ailoy-sidebar-hidden')) document.documentElement.setAttribute('data-sidebar-hidden', '');
    } catch {}
    document.documentElement.dataset.theme = theme;
    window.StarlightThemeProvider = { updatePickers() {} };
  })();
</script>
