{
  "entryPoints": ["node_modules/@brekkylab/ailoy/index.d.ts"],
  "tsconfig": "tsconfig.json",
  "skipErrorChecking": true,
  "excludeExternals": true,
  "externalPattern": ["**/@brekkylab/virtx/**", "**/@types/**"],
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-frontmatter", "./starlight-plugin.mjs"],
  "out": "../content/reference/nodejs",
  "cleanOutputDir": true,
  "readme": "none",
  "outputFileStrategy": "members",
  "flattenOutputFiles": true,
  "fileExtension": ".md",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "hidePageTitle": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "sanitizeComments": true,
  "disableSources": true,
  "sort": ["source-order"]
}
